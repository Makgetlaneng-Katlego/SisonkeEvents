<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationContainer"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="15dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover page"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/dark_gray"
                android:textStyle="bold"/>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_marginTop="15dp"
                android:layout_height="wrap_content">
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="45dp" >

                    <RelativeLayout
                        android:id="@+id/musicCategory"
                        android:layout_width="175dp"
                        android:layout_height="120dp"
                        android:layout_column="0"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/discoverybackground">

                        <ImageView
                            android:id="@+id/musicImage"
                            android:layout_width="175dp"
                            android:layout_height="99dp"
                            android:src="@drawable/music" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/musicImage"
                            android:layout_centerHorizontal="true"
                            android:text="Music" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/comedyCategory"
                        android:layout_width="175dp"
                        android:layout_height="120dp"
                        android:layout_column="1"
                        android:background="@drawable/discoverybackground">

                        <ImageView
                            android:id="@+id/comedyImage"
                            android:layout_width="175dp"
                            android:layout_height="99dp"
                            android:src="@drawable/comedy" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/comedyImage"
                            android:layout_centerHorizontal="true"
                            android:text="comedy" />
                    </RelativeLayout>

                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_height="45dp" >

                    <RelativeLayout
                        android:id="@+id/sportsCategory"
                        android:layout_width="175dp"
                        android:layout_height="120dp"
                        android:layout_column="0"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/discoverybackground">

                        <ImageView
                            android:id="@+id/sportsImage"
                            android:layout_width="175dp"
                            android:layout_height="99dp"
                            android:src="@drawable/sports" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/sportsImage"
                            android:layout_centerHorizontal="true"
                            android:text="Sports" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/foodCategory"
                        android:layout_width="175dp"
                        android:layout_height="120dp"
                        android:layout_column="1"
                        android:background="@drawable/discoverybackground">

                        <ImageView
                            android:id="@+id/foodImage"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:src="@drawable/food" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/foodImage"
                            android:layout_centerHorizontal="true"
                            android:text="Food and Drinks" />
                    </RelativeLayout>

                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_height="45dp" >

                    <RelativeLayout
                        android:id="@+id/educationCategory"
                        android:layout_width="175dp"

                        android:layout_height="120dp"
                        android:layout_column="0"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/discoverybackground">

                        <ImageView
                            android:id="@+id/educationImage"
                            android:layout_width="175dp"
                            android:layout_height="99dp"
                            android:src="@drawable/education" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/educationImage"
                            android:layout_centerHorizontal="true"
                            android:text="Education" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/familyCategory"
                        android:layout_width="175dp"
                        android:layout_height="120dp"
                        android:layout_column="1"
                        android:background="@drawable/discoverybackground">

                        <ImageView
                            android:id="@+id/familyImage"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:src="@drawable/family" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/familyImage"
                            android:layout_centerHorizontal="true"
                            android:text="Family Events" />
                    </RelativeLayout>

                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_height="45dp" >

                    <RelativeLayout
                        android:id="@+id/communityCategory"
                        android:layout_width="175dp"
                        android:layout_height="120dp"
                        android:layout_column="0"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/discoverybackground">

                        <ImageView
                            android:id="@+id/communityImage"
                            android:layout_width="175dp"
                            android:layout_height="99dp"
                            android:src="@drawable/community" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/communityImage"
                            android:layout_centerHorizontal="true"
                            android:text="Community Events" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/festivalCategory"
                        android:layout_width="175dp"
                        android:layout_height="120dp"
                        android:layout_column="1"
                        android:background="@drawable/discoverybackground">

                        <ImageView
                            android:id="@+id/festivalImage"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:src="@drawable/comedy" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/festivalImage"
                            android:layout_centerHorizontal="true"
                            android:text="Festival Events" />
                    </RelativeLayout>

                </TableRow>
            </TableLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavigationContainer"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
