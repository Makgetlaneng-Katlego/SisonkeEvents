<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:id="@+id/btnChangeProfileBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/profile_arrow"
                    android:rotation="180"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/cd_back"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_change_profile"
                    android:textColor="@color/dark_gray"
                    android:layout_centerInParent="true"
                    android:textStyle="bold"
                    android:textSize="20sp" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/desc_change_profile"
                android:textColor="@color/light_gray"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_first_name"
                android:textColor="#7A7A7A"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNewFirstName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="12dp"
                android:hint="@string/hint_first_name"
                android:textColorHint="#BFBFBF"
                android:inputType="textPersonName"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/account_input_background"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_last_name"
                android:textColor="#7A7A7A"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNewLastName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="12dp"
                android:hint="@string/hint_last_name"
                android:textColorHint="#BFBFBF"
                android:inputType="textPersonName"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/account_input_background"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_phone_number"
                android:textColor="#7A7A7A"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNewPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="12dp"
                android:hint="@string/hint_phone_number"
                android:textColorHint="#BFBFBF"
                android:inputType="phone"
                android:textSize="15sp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/account_input_background"/>

            <Button
                android:id="@+id/btnUpdateProfileSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/loginbtn_background"
                android:text="@string/btn_update_profile"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"/>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>